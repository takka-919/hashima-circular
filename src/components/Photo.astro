---
// 写真。src があれば画像、無ければ「写真準備中」の面だけを出す（DESIGN.md 4. Photo Placeholder）
// src は public/ 以下のパス（例: 'images/news/survey.jpg'）
import { url } from '../lib/utils';
interface Props { src?: string; alt?: string; label?: string; shape?: 'card' | 'capsule' | 'square' | 'free'; class?: string; eager?: boolean }
const { src, alt = '', label = '写真準備中', shape = 'card', class: cls = '', eager = false } = Astro.props;
const shapeCls = shape === 'capsule' ? 'photo--capsule' : shape === 'square' ? 'photo--square' : '';
---
{src ? (
  <div class:list={['photo', shapeCls, cls]}>
    <img src={src.startsWith('http') ? src : url(src)} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </div>
) : (
  <figure class:list={['photo', 'photo--ph', shapeCls, cls]} role="img" aria-label={`${alt || label}（写真準備中）`}>
    <figcaption>{label}</figcaption>
  </figure>
)}
