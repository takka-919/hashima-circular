---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/utils';
import Photo from './Photo.astro';
import Arrow from './Arrow.astro';
interface Props { entry: CollectionEntry<'events'> }
const { entry } = Astro.props;
const d = entry.data;
---
<a class="event-row reveal" href={url(`events/${entry.id}/`)}>
  <Photo src={d.cover} alt={d.coverAlt ?? d.title} label="告知画像準備中" tone="moss" />
  <div>
    <div class="card-meta"><span class={`tag ${d.status === '募集中' ? 'tag--fill' : 'tag--river'}`}>{d.status}</span><span>{d.audience}</span></div>
    <h3>{d.title}</h3>
    <p>{d.summary}</p>
    <p class="event-when">日時：{d.dateText}　／　会場：{d.venue}</p>
    <span class="link-more">詳細を見る <Arrow /></span>
  </div>
</a>
