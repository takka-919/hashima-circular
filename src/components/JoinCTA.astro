---
import { url } from '../lib/utils';
import Photo from './Photo.astro';
---
<section class="join" aria-labelledby="join-cta-title">
  <div class="container inner">
    <div>
      <span class="eyebrow">Join us</span>
      <h2 class="h2" id="join-cta-title">羽島の川のこと、<br />一緒に調べてみませんか。</h2>
      <p style="margin-top:16px">イベントへの参加、授業づくり、調査やものづくりへの協力。関わり方はいろいろあります。</p>
      <div class="btn-row" style="margin-top:28px">
        <a class="btn" href={url('join/')}>関わり方を見る</a>
        <a class="btn" href={url('contact/')}>相談する</a>
      </div>
    </div>
    <Photo shape="capsule" label="写真準備中｜イベントで川を観察する親子" alt="イベントで川を観察する親子" />
  </div>
</section>
