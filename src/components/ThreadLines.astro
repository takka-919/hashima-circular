---
// 糸と川の流れを重ねた装飾ライン
interface Props { class?: string; animate?: boolean; lines?: number }
const { class: cls = 'thread-deco', animate = false, lines = 5 } = Astro.props;
const paths = Array.from({ length: lines }, (_, i) => {
  const y = 40 + i * 22;
  const a = 26 + i * 4;
  return `M-20 ${y} C 140 ${y - a}, 260 ${y + a}, 420 ${y} S 700 ${y - a}, 860 ${y + i * 3} S 1120 ${y + a}, 1240 ${y - 6}`;
});
---
<svg class={cls} viewBox="0 0 1200 180" preserveAspectRatio="none" fill="none" aria-hidden="true">
  {paths.map((d, i) => (
    <path d={d} class={animate ? 'thread-path' : undefined} style={animate ? `animation-delay:${0.15 * i}s` : undefined}
      stroke="currentColor" stroke-width={i === 2 ? 1.6 : 0.8} opacity={i === 2 ? 1 : 0.55} vector-effect="non-scaling-stroke" />
  ))}
</svg>
