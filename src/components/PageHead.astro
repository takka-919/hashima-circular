---
import { url } from '../lib/utils';
import DisplayHead from './DisplayHead.astro';
interface Props { en: string; ja: string; title?: string; lead?: string; crumbs?: { href?: string; label: string }[] }
const { en, ja, title, lead, crumbs = [] } = Astro.props;
---
<header class="page-head">
  <div class="container">
    <nav aria-label="パンくずリスト">
      <ol class="breadcrumb">
        <li><a href={url()}>トップ</a></li>
        {crumbs.map((c) => <li>{c.href ? <a href={url(c.href)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
      </ol>
    </nav>
    <DisplayHead en={en} ja={ja} />
    <h1>{title ?? ja}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>
