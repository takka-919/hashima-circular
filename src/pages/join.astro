---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import SectionHead from '../components/SectionHead.astro';
import { url } from '../lib/utils';
const ways = [
  { who: '地域の皆さん・親子', title: 'イベントに参加する', text: '川の生きものを学び、地域の自然に触れる。', cta: 'イベントを見る', href: 'events/' },
  { who: '学校・教育関係者', title: '一緒に学びをつくる', text: '環境学習の授業や教材、教育イベントについてご相談ください。', cta: '教育連携を相談する', href: 'contact/?type=school' },
  { who: '企業・地域団体', title: '活動に協力する', text: '技術・素材・会場など、それぞれにできることを持ち寄りましょう。', cta: '協力を相談する', href: 'contact/?type=company' },
  { who: '研究者・専門家', title: '調査・研究をつなぐ', text: '川や自然、社会の価値について、専門知識を持ち寄ってください。', cta: '研究連携を相談する', href: 'contact/?type=research' },
  { who: '農業関係者・住民', title: '地域の声を届ける', text: '川との関わりや、地域で気づいたことを教えてください。', cta: '地域活動を相談する', href: 'contact/?type=local' },
  { who: '行政・支援機関', title: '地域のつながりを広げる', text: '周知やネットワークづくりへのご協力をご相談ください。', cta: '連携を相談する', href: 'contact/?type=other' },
];
---
<Base title="仲間になる" description="イベントへの参加、教育・研究・企業連携など、羽島サーキュラーエコノミープロジェクトへの関わり方をご紹介します。">
  <PageHead en="JOIN US" ja="仲間になる" title="仲間になる" lead="あなたの関心や得意なことを、地域の活動につなげませんか。" crumbs={[{ label: '仲間になる' }]} />
  <section class="section">
    <div class="container">
      <SectionHead en="Ways to join" title="こんな関わり方があります" /><p style="margin:-24px 0 40px">まずはイベントへの参加や、協力のご相談から。募集内容は受け入れ体制に合わせて更新します。</p>
      <div class="ways">
        {ways.map((w) => (
          <div class="way"><span class="who">{w.who}</span><h3>{w.title}</h3><p>{w.text}</p><a class="btn" href={url(w.href)}>{w.cta}</a></div>
        ))}
      </div>
    </div>
  </section>
  <section class="section section--water">
    <div class="container">
      <SectionHead en="Flow" title="相談から参加まで" />
      <ol class="steps">
        <li><h3>関心を伝える</h3><p>相談フォームから、興味のある活動や協力したいことをお知らせください。</p></li>
        <li><h3>一緒に話す</h3><p>担当者からご連絡し、活動内容や関わり方をご相談します。</p></li>
        <li><h3>できることから始める</h3><p>お互いに無理のない方法で、活動への参加を始めます。</p></li>
      </ol>
      <div style="margin-top:40px"><a class="btn" href={url('contact/')}>参加・連携について相談する</a></div>
    </div>
  </section>
</Base>
