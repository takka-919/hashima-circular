---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Photo from '../components/Photo.astro';
import SectionHead from '../components/SectionHead.astro';
import JoinCTA from '../components/JoinCTA.astro';
import { PARTNERS } from '../site.config';
---
<Base title="プロジェクトについて" description="なぜ桑原川から始めるのか。羽島の自然と産業がともに歩む未来を考える、羽島サーキュラーエコノミープロジェクトの考え方と進め方。">
  <PageHead en="ABOUT" ja="活動について" title="プロジェクトについて" lead="羽島の自然と産業が、ともに続いていくために。" crumbs={[{ label: 'プロジェクトについて' }]} />

  <section class="section">
    <div class="container split">
      <div>
        <span class="label">なぜ桑原川から</span>
        <p>長谷虎紡績は1887年に羽島で創業し、いまも羽島市内の工場で糸やカーペットをつくっています。ものづくりには水が欠かせません。</p>
        <p>工場の排水は「環境に悪いのでは」と心配されることがあります。けれど、その水が実際に川の生きものとどう関わっているのかは、これまできちんと調べられてきませんでした。</p>
        <p class="mb-0">そこで、工場の近くを流れる桑原川を最初のフィールドに、川の水と生きものを調べることにしました。</p>
      </div>
      <Photo shape="capsule" src="images/plain.jpg" alt="田んぼと川の向こうに工場と町並み、遠くに山が見える風景" credit="イメージ（AI生成）" />
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <span class="label">めざしていること</span>
      <p>心配を、事実にもとづく信頼に変えていくこと。調べた結果は良いことも悪いこともそのまま公開し、地域の皆さんと一緒にこれからを考えます。</p>
      <p class="mb-0">工場から出た水や素材が、地域の自然の中でふたたび役に立つ。羽島の川と工場から、そんな「循環」のかたちを探ります。</p>
    </div>
  </section>

  <section class="section section--water">
    <div class="container">
      <SectionHead en="Approach" title="進め方" />
      <ol class="steps">
        <li><h3>川と地域を知る</h3><p>環境DNAや採集による生きもの調査、水質の調査、地域の方へのアンケートを行います。</p></li>
        <li><h3>分かったことを共有する</h3><p>結果をこのサイトや地域のイベントで公開し、対話の場をつくります。</p></li>
        <li><h3>一緒に実践する</h3><p>調査で分かったことをもとに、川の保全や、自然に配慮したものづくりを考えます。</p></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead en="Team" title="3つの視点" />
      <div class="partner-row">
        {PARTNERS.map((p) => <a href={`../partners/#${p.id}`}><span>{p.field}｜{p.short}</span><b>{p.role}</b></a>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <SectionHead en="History" title="これまでの歩み" />
      <ol class="timeline">
        <li><span class="when">2026年6月</span><p>長谷虎紡績・イノカ・aiESGの3社が連携協定を締結</p></li>
        <li><span class="when">現在</span><p>流域の生きもの調査、意識調査、教育イベントの準備</p></li>
        <li><span class="when">これから</span><p>調査結果を公開し、地域で一緒に取り組む仲間を広げる</p></li>
      </ol>
    </div>
  </section>

  <JoinCTA />
</Base>
