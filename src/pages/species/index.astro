---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import SpeciesCard from '../../components/SpeciesCard.astro';
import JoinCTA from '../../components/JoinCTA.astro';
import { isPublished } from '../../lib/utils';
const species = (await getCollection('species', isPublished)).sort((a, b) => a.data.order - b.data.order);
const groups = ['すべて', ...new Set(species.map((s) => s.data.group))];
const origins = ['すべて', '在来', '国外外来', '国内外来', '判定保留'];
const endemics = ['すべて', '日本固有', '固有ではない', '未確認'];
---
<Base title="桑原川の生きもの図鑑" description="桑原川に暮らす生きものの特徴や、調査で確認した記録を紹介する図鑑です。">
  <PageHead en="CREATURES" ja="生きもの図鑑" title="桑原川の生きもの図鑑" lead="川に暮らす生きものを知る。特徴や、調査での確認記録を紹介します。" crumbs={[{ label: '生きもの図鑑' }]} />
  <section class="section">
    <div class="container">
      {species.length ? (
        <>
          <div class="filters" id="filters">
            <div class="filter-row"><label class="label-s" for="q">名前で探す</label><input class="search" id="q" type="search" placeholder="例：メダカ" /></div>
            <div class="filter-row" role="group" aria-label="分類群" data-key="group"><span class="label-s">分類群</span>{groups.map((g, i) => <button class="chip" type="button" data-v={g} aria-pressed={i === 0 ? 'true' : 'false'}>{g}</button>)}</div>
            <div class="filter-row" role="group" aria-label="在来・外来" data-key="origin"><span class="label-s">在来・外来</span>{origins.map((g, i) => <button class="chip" type="button" data-v={g} aria-pressed={i === 0 ? 'true' : 'false'}>{g}</button>)}</div>
            <div class="filter-row" role="group" aria-label="固有性" data-key="endemic"><span class="label-s">固有性</span>{endemics.map((g, i) => <button class="chip" type="button" data-v={g} aria-pressed={i === 0 ? 'true' : 'false'}>{g}</button>)}</div>
            <p class="small mb-0" aria-live="polite"><span id="count">{species.length}</span>件を表示中</p>
          </div>
          <div class="cards" id="species-list">{species.map((s) => <SpeciesCard entry={s} />)}</div>
        </>
      ) : (
        <div class="empty">
          <h3>図鑑は調査中です</h3>
          <p>桑原川で見つかった生きものは、専門家が種類を確かめてから載せます。在来か外来かといった区分も、根拠とあわせて紹介する予定です。</p>
        </div>
      )}
      <div class="notice" style="margin-top:48px">
        <b>図鑑の見方</b><br />
        「在来」はもともと桑原川周辺に生息している生きもの、「国外外来」は海外から持ち込まれた生きもの、「国内外来」は日本国内の別の地域から持ち込まれた生きものです。区分が確定していないものは「判定保留」としています。
      </div>
    </div>
  </section>
  <JoinCTA />
</Base>
<script>
  const state: Record<string, string> = { group: 'すべて', origin: 'すべて', endemic: 'すべて' };
  const q = document.getElementById('q') as HTMLInputElement | null;
  const cards = document.querySelectorAll<HTMLElement>('#species-list > .card');
  const count = document.getElementById('count');
  function apply() {
    const term = (q?.value ?? '').trim();
    let n = 0;
    cards.forEach((c) => {
      const ok = (!term || (c.dataset.name ?? '').includes(term))
        && Object.entries(state).every(([k, v]) => v === 'すべて' || c.dataset[k] === v);
      c.hidden = !ok; if (ok) n++;
    });
    if (count) count.textContent = String(n);
  }
  document.querySelectorAll<HTMLElement>('#filters [data-key]').forEach((row) => {
    const chips = row.querySelectorAll<HTMLButtonElement>('.chip');
    chips.forEach((chip) => chip.addEventListener('click', () => {
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      state[row.dataset.key!] = chip.dataset.v!;
      apply();
    }));
  });
  q?.addEventListener('input', apply);
</script>
