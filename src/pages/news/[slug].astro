---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import JoinCTA from '../../components/JoinCTA.astro';
import { url, formatDate, isPublished } from '../../lib/utils';
export async function getStaticPaths() {
  const news = await getCollection('news', isPublished);
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary}>
  <article class="article">
    <div class="container narrow">
      <nav aria-label="パンくずリスト"><ol class="breadcrumb"><li><a href={url()}>トップ</a></li><li><a href={url('news/')}>活動報告</a></li><li><span aria-current="page">記事</span></li></ol></nav>
      <header class="article-head">
        <div class="card-meta" style="justify-content:flex-start;gap:14px"><span class="tag">{d.category}</span><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></div>
        <h1>{d.title}</h1>
        <p class="muted mb-0">{d.summary}</p>
      </header>
      {d.cover && <Photo src={d.cover} alt={d.coverAlt ?? d.title} credit={d.coverCredit} eager />}
      <div class="prose"><Content /></div>
      <div class="article-foot">
        <a class="btn" href={url('news/')}>活動報告の一覧へ</a>
        <a class="btn" href={url('events/')}>イベントを見る</a>
      </div>
    </div>
  </article>
  <JoinCTA />
</Base>
