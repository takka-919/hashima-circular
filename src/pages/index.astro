---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import SectionHead from '../components/SectionHead.astro';
import NewsCard from '../components/NewsCard.astro';
import EventRow from '../components/EventRow.astro';
import SpeciesCard from '../components/SpeciesCard.astro';
import JoinCTA from '../components/JoinCTA.astro';
import { url, isPublished } from '../lib/utils';
import { PARTNERS } from '../site.config';

const news = (await getCollection('news', isPublished)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const events = (await getCollection('events', isPublished))
  .filter((e) => e.data.status === '募集中' || e.data.status === '準備中')
  .sort((a, b) => (+(a.data.date ?? Infinity)) - (+(b.data.date ?? Infinity)))
  .slice(0, 2);
const species = (await getCollection('species', isPublished)).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---
<Base overHero>
  <section class="hero" aria-label="メインビジュアル">
    <Photo shape="free" src="images/hero.jpg" alt="田植え後の水田のあいだを流れる、コンクリート護岸の小さな川" credit="イメージ（AI生成）" eager />
    <div class="hero-body">
      <h1 class="hero-copy"><span>羽島の川を、</span><br /><span>工場と地域で、</span><br /><span>いっしょに調べる。</span></h1>
      <p class="hero-sub">羽島サーキュラーエコノミープロジェクト ─ 長谷虎紡績・イノカ・aiESG</p>
      <div class="btn-row">
        <a class="btn btn--light" href={url('events/')}>イベントを見る</a>
        <a class="btn btn--light" href={url('join/')}>仲間になる</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="news-title">
    <div class="container">
      <div class="head-row">
        <SectionHead en="News" title="活動報告" id="news-title" />
        <a class="btn" href={url('news/')}>すべて見る</a>
      </div>
      <div class="cards">{news.map((n) => <NewsCard entry={n} />)}</div>
    </div>
  </section>

  <section class="section" aria-labelledby="about-title">
    <div class="container split">
      <div>
        <SectionHead en="About" title="工場の排水と、<br />川の生きもの。" id="about-title" />
        <p>羽島で140年近く糸をつくってきた長谷虎紡績の工場は、桑原川のそばにあります。工場から出る水は、川の生きものにどう関わっているのか。</p>
        <p>まずは川の今を調べて、分かったことを地域の皆さんと共有するところから始めます。</p>
        <a class="btn" href={url('about/')}>プロジェクトについて</a>
      </div>
      <Photo shape="capsule" src="images/river-life.jpg" alt="浅い川の水中を泳ぐ銀色の小魚たち" credit="イメージ（AI生成）" />
    </div>
  </section>

  <div class="stripe stripe--right" aria-hidden="true"></div>

  <section class="section" aria-labelledby="events-title">
    <div class="container">
      <div class="head-row">
        <SectionHead en="Events" title="参加できるイベント" id="events-title" />
        <a class="btn" href={url('events/')}>すべて見る</a>
      </div>
      {events.length ? events.map((e) => <EventRow entry={e} />) : <div class="empty"><p>いま募集しているイベントはありません。</p></div>}
    </div>
  </section>

  <section class="section section--water" aria-labelledby="species-title">
    <div class="container">
      <div class="head-row">
        <SectionHead en="Life in the river" title="桑原川の生きもの" id="species-title" />
        <a class="btn" href={url('species/')}>図鑑を見る</a>
      </div>
      {species.length ? (
        <div class="cards">{species.map((s) => <SpeciesCard entry={s} />)}</div>
      ) : (
        <div class="empty" style="background:#fff">
          <h3>図鑑は調査中です</h3>
          <p class="mb-0">桑原川で見つかった生きものを、専門家が確認したものから順に載せていきます。</p>
        </div>
      )}
    </div>
  </section>

  <section class="section" aria-labelledby="partners-title">
    <div class="container">
      <div class="head-row">
        <SectionHead en="Partners" title="運営する3社" id="partners-title" />
        <a class="btn" href={url('partners/')}>各社の役割</a>
      </div>
      <div class="partner-row">
        {PARTNERS.map((p) => <a href={url(`partners/#${p.id}`)}><span>{p.field}</span><b>{p.name}</b></a>)}
      </div>
    </div>
  </section>

  <JoinCTA />
</Base>
