---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import JoinCTA from '../../components/JoinCTA.astro';
import { url, isPublished } from '../../lib/utils';
export async function getStaticPaths() {
  const events = await getCollection('events', isPublished);
  return events.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const canApply = d.status === '募集中' && d.applyUrl;
---
<Base title={d.title} description={d.summary}>
  <article class="article">
    <div class="container narrow">
      <nav aria-label="パンくずリスト"><ol class="breadcrumb"><li><a href={url()}>トップ</a></li><li><a href={url('events/')}>イベント</a></li><li><span aria-current="page">詳細</span></li></ol></nav>
      <header class="article-head">
        <div class="card-meta" style="justify-content:flex-start;gap:14px"><span class:list={['tag', { 'tag--line': d.status !== '募集中' }]}>{d.status}</span><span class="small">{d.audience}</span></div>
        <h1>{d.title}</h1>
        <p class="muted mb-0">{d.summary}</p>
      </header>
      <Photo src={d.cover} alt={d.coverAlt ?? d.title} label="告知画像準備中" eager />
      <div class="prose"><Content /></div>
      <h2 class="sub-h">開催概要</h2>
      <dl class="dl">
        <dt>日時</dt><dd>{d.dateText}</dd>
        <dt>会場</dt><dd>{d.venue}</dd>
        <dt>対象</dt><dd>{d.audience}</dd>
        <dt>定員</dt><dd>{d.capacity}</dd>
        <dt>参加費</dt><dd>{d.fee}</dd>
        <dt>申込期限</dt><dd>{d.deadline}</dd>
      </dl>
      <div class="article-foot">
        {canApply
          ? <a class="btn" href={d.applyUrl} target="_blank" rel="noopener">申し込む</a>
          : <a class="btn" href={url('contact/?type=event')}>開催のお知らせを希望する</a>}
        <a class="btn" href={url('events/')}>イベント一覧へ</a>
      </div>
    </div>
  </article>
  <JoinCTA />
</Base>
