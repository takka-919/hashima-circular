---
import '@fontsource/zen-kaku-gothic-new/400.css';
import '@fontsource/zen-kaku-gothic-new/500.css';
import '@fontsource/zen-kaku-gothic-new/700.css';
import '@fontsource/jost/latin-400.css';
import '@fontsource/jost/latin-500.css';
import '../styles/global.css';
import { SITE, NAV, PARTNERS } from '../site.config';
import { url } from '../lib/utils';

interface Props { title?: string; description?: string; ogImage?: string; overHero?: boolean }
const { title, description = SITE.description, ogImage = 'og.png', overHero = false } = Astro.props;
const fullTitle = title ? `${title}｜${SITE.name}` : SITE.name;
const path = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const isCurrent = (href: string) => path.startsWith(`${base}/${href}`);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(url(ogImage), Astro.site);
const navItems = [...NAV, { href: 'join/', label: '仲間になる' }, { href: 'contact/', label: 'お問い合わせ' }];
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">本文へ移動</a>
    <header class:list={['site-header', { 'site-header--over': overHero }]}>
      <div class="header-inner">
        <a class="logo" href={url()}>
          <b>羽島サーキュラーエコノミープロジェクト</b>
          <span>HASHIMA CIRCULAR ECONOMY PROJECT</span>
        </a>
      </div>
    </header>
    <div class="gnav-wrap">
      <button class="menu-btn" id="menu-btn" aria-label="メニューを開く" aria-expanded="false" aria-controls="gnav"><span></span><span></span><span></span></button>
      <nav class="gnav" id="gnav" aria-label="メインメニュー">
        {navItems.map((n) => <a href={url(n.href)} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
    </div>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-grid">
          <div>
            <a class="logo" href={url()}><b>羽島サーキュラーエコノミープロジェクト</b><span>HASHIMA CIRCULAR ECONOMY PROJECT</span></a>
            <p class="footer-orgs">運営：{PARTNERS.map((p) => p.name).join('・')}</p>
          </div>
          <div>
            <span class="footer-h">Project</span>
            <ul class="footer-nav">{NAV.map((n) => <li><a href={url(n.href)}>{n.label}</a></li>)}</ul>
          </div>
          <div>
            <span class="footer-h">Contact</span>
            <ul class="footer-nav">
              <li><a href={url('join/')}>仲間になる</a></li>
              <li><a href={url('contact/')}>お問い合わせ・連携相談</a></li>
              <li><a href={url('privacy/')}>個人情報の取り扱い</a></li>
            </ul>
          </div>
        </div>
        <p class="ai-note">「イメージ（AI生成）」と表示した画像は生成AIで制作したイメージです。実際の桑原川・工場・イベントの写真ではありません。</p>
        <small class="copyright">&copy; {new Date().getFullYear()} {SITE.name}</small>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn');
      const nav = document.getElementById('gnav');
      btn?.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        btn.setAttribute('aria-label', open ? 'メニューを開く' : 'メニューを閉じる');
        nav?.classList.toggle('is-open', !open);
      });
    </script>
  </body>
</html>
